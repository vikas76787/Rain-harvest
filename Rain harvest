<body>
<header class="hero">
 <div class="wrap top"><div class="brand"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c3.6 4.4 6 7.6 6 11a6 6 0 0 1-12 0c0-3.4 2.4-6.6 6-11z"/></svg><span>RainHarvest Calculator</span></div><button type="button" class="pill" id="theme" aria-label="Switch light or dark mode">☾</button></div>
 <div class="wrap hg">
  <div><h1>Every Drop Counts</h1><p class="lead">Save water, save life. Find out how much rainwater your rooftop can collect in a year, then ask our helper how to use it.</p><a class="btn gold" href="#calculator">Calculate my rooftop</a><p class="small">Free, instant and no signup needed.</p></div>
  <figure class="sum"><div class="sr"><span class="op"></span><span class="n">1 mm</span><span class="w">of rain</span></div><div class="sr"><span class="op">×</span><span class="n">1 m²</span><span class="w">of roof</span></div><div class="sr t"><span class="op">=</span><span class="n">1 litre</span><span class="w">of water</span></div></figure>
 </div>
 <svg class="waves" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40c150-40 300 40 450 0s300-40 450 0 210 20 300 0v50H0z" fill="var(--bg)" opacity=".4"/><path d="M0 60c150-30 300 30 450 0s300-30 450 0 210 14 300 0v30H0z" fill="var(--bg)"/></svg>
</header>
<main>
<section id="calculator" class="wrap calc">
 <div id="form" class="panel">
  <h2>Calculate Your Rainwater Potential</h2><p class="muted">Enter your rooftop details to estimate annual rainwater collection.</p>
  <div class="field"><label for="city">Your city</label><input id="city" list="cities" placeholder="Type a city, e.g. Pune" autocomplete="off"><datalist id="cities"></datalist><p class="hint" id="cityHint" aria-live="polite"></p></div>
  <div class="field"><label for="area">Rooftop Area</label><div class="row"><input id="area" type="number" inputmode="decimal" min="0.01" step="any" placeholder="e.g. 100" aria-describedby="areaErr"><select id="unit" aria-label="Area unit"><option value="m2">m²</option><option value="sqft">sq ft</option></select></div><div class="error" id="areaErr" role="alert" hidden></div></div>
  <div class="field"><label for="rain">Annual Rainfall (mm)</label><input id="rain" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 800" aria-describedby="rainHint rainErr"><p class="hint" id="rainHint">City values are approximate long-term averages. Use your local figure for a better estimate.</p><div class="error" id="rainErr" role="alert" hidden></div></div>
  <div class="field"><label for="eff">Collection efficiency (%)</label><div class="row"><input id="eff" type="number" inputmode="decimal" min="1" max="100" step="any" value="80" aria-describedby="effErr"><select id="effp" aria-label="Roof type preset"><option value="">Custom</option><option value="90">Metal 90%</option><option value="80" selected>Concrete 80%</option><option value="70">Tiled 70%</option><option value="40">Terrace garden 40%</option></select></div><p class="hint">Type your own value, or pick a roof type to fill it in.</p><div class="error" id="effErr" role="alert" hidden></div></div>
  <div class="field"><label for="pur">Water purification method</label><select id="pur"><option value="90" selected>Sand + charcoal filter (about 90% usable)</option><option value="85">Filter + UV or chlorine (about 85%)</option><option value="55">Filter + RO (about 55%)</option></select><p class="hint">Shows how much of the harvested water stays usable as clean drinking water after treatment.</p></div>
  <details class="adv"><summary>More options (optional)</summary><div class="ag">
   <div class="field"><label for="people">People in household</label><input id="people" type="number" inputmode="numeric" min="1" step="1" value="4"></div>
   <div class="field"><label for="lpcd">Daily water use per person (litres)</label><input id="lpcd" type="number" inputmode="decimal" min="1" step="any" value="135"></div>
   <div class="field"><label for="dry">Dry-period storage (days)</label><input id="dry" type="number" inputmode="numeric" min="0" step="1" value="30"></div>
   <div class="field"><label for="cost">Water cost (₹ per 1,000 litres)</label><input id="cost" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 20"></div></div>
   <p class="hint">About 135 litres per person is a common urban planning figure.</p></details>
  <div class="act"><button type="button" class="btn pri" id="calc">Calculate Rainwater</button><button type="button" class="btn ghost" id="reset">Reset</button></div>
  <p class="formula">Harvest (litres) = Roof area (m²) × Rainfall (mm) × Efficiency</p>
 </div>
 <aside id="results" class="results" aria-live="polite">
  <h2>Your Results</h2>
  <p class="empty">Enter your roof area and rainfall, then press Calculate to see your numbers.</p>
  <div class="data">
   <div class="rt"><div><div class="lbl">You can collect</div><div class="big"><span id="rL">0</span><span class="unit">litres / year</span></div><p class="covers"><span class="pct" id="rP">0%</span>of your household’s yearly water need</p></div>
    <svg class="tank" viewBox="0 0 100 150" aria-hidden="true"><defs><clipPath id="tc"><rect x="10" y="10" width="80" height="130" rx="10"/></clipPath></defs><rect x="10" y="10" width="80" height="130" rx="10" fill="rgba(255,255,255,.07)"/><g clip-path="url(#tc)"><g id="water" style="transform:translateY(130px)"><rect x="0" y="10" width="100" height="150" fill="#2bb3d1" opacity=".9"/></g></g><rect x="10" y="10" width="80" height="130" rx="10" fill="none" stroke="rgba(255,255,255,.6)" stroke-width="2.5"/></svg></div>
   <div class="pm"><div class="pml"><span>Purification yield</span><b id="rPy"></b></div><div class="pmt"><i id="pmf"></i></div></div>
   <dl class="rows"><div><dt>Daily average</dt><dd id="rD"></dd></div><div><dt>Household need per year</dt><dd id="rN"></dd></div><div><dt>Suggested tank size</dt><dd id="rT"></dd></div><div><dt>Recharge pit (about)</dt><dd id="rPit"></dd></div><div><dt>Wettest month (Jul)</dt><dd id="rW"></dd></div><div><dt>Purified, safe-to-drink water</dt><dd id="rU"></dd></div><div><dt>Drinking need covered</dt><dd id="rUp"></dd></div><div><dt>Water value saved</dt><dd id="rS"></dd></div></dl>
   <div class="bars" id="bars" aria-label="Monthly rainwater estimate"></div><p class="note">Monthly split follows a typical monsoon pattern. Real months vary.</p>
   <div class="ra"><button type="button" class="btn gold" id="plan">Get my plan</button><button type="button" class="btn ghost" id="dl">Download report</button><a class="btn wa" id="wa" target="_blank" rel="noopener">Share on WhatsApp</a></div>
  </div>
 </aside>
</section>

<section id="ai" class="wrap block">
 <h2 class="h">Ask RainHarvest Helper</h2>
 <div class="panel ai">
