 pit:["Recharge pit"+(s?" for your roof: about "+pt+" m³":"")+". Dig 1 m wide × 1.5–2 m deep, fill with big stones at the bottom, then gravel, then coarse sand on top. Keep it 3 m away from building foundations and well away from septic tanks. Put a silt trap before it.","रिचार्ज पिट"+(s?" (आपकी छत के लिए करीब "+pt+" m³)":"")+": 1 मीटर चौड़ा, 1.5–2 मीटर गहरा खोदें। नीचे बड़े पत्थर, फिर कंकड़, ऊपर मोटी रेत भरें। नींव से 3 मीटर दूर और सेप्टिक टैंक से काफ़ी दूर रखें।","Recharge pit"+(s?" (aapki chhat ke liye lagbhag "+pt+" m³)":"")+": 1 meter chauda, 1.5–2 meter gehra khodo. Neeche bade patthar, phir kankad, upar moti ret. Neenv se 3 meter door aur septic tank se kaafi door rakho."],
 monsoon:["Before the rains: clean roof, gutters and mesh, flush the pipes, check the tank cover and overflow. During: empty the first-flush chamber after each storm. After: clean the filter, look for leaks and cracks, and check for mosquitoes.","बारिश से पहले: छत, गटर और जाली साफ करें, पाइप धोएं, टैंक का ढक्कन और ओवरफ्लो देखें। बारिश में: हर तूफान के बाद फर्स्ट-फ्लश खाली करें। बाद में: फिल्टर साफ करें, लीकेज और मच्छर देखें।","Barish se pehle: chhat, gutter aur jaali saaf karo, pipe dho lo, tank ka dhakkan aur overflow check karo. Barish mein: har toofan ke baad first-flush khaali karo. Baad mein: filter saaf karo, leakage aur machhar dekho."],
 plan:[s?"Your plan: your roof can collect about "+fmt(s.L)+" litres a year, covering "+(s.pct>100?"100%+":Math.round(s.pct))+"% of household need.\n1) Fit gutters, mesh and a first-flush diverter.\n2) Install a covered tank of about "+tk+" litres.\n3) Send overflow to a recharge pit of about "+pt+" m³.\n4) Use stored water for gardening, cleaning and flushing, and treat it before any drinking use.":"Run the calculator first, then I can make a plan with your numbers.",s?"आपकी योजना: छत से सालाना करीब "+fmt(s.L)+" लीटर पानी मिलेगा।\n1) गटर, जाली और फर्स्ट-फ्लश लगाएं।\n2) करीब "+tk+" लीटर का ढका टैंक लगाएं।\n3) ओवरफ्लो को करीब "+pt+" m³ के रिचार्ज पिट में भेजें।\n4) पानी बागवानी, सफाई और फ्लश में इस्तेमाल करें।":"पहले कैलकुलेटर चलाएं, फिर मैं आपके नंबरों से योजना बनाऊंगा।",s?"Aapka plan: chhat se saal bhar mein lagbhag "+fmt(s.L)+" litre paani milega.\n1) Gutter, jaali aur first-flush lagao.\n2) Lagbhag "+tk+" litre ka dhaka tank lagao.\n3) Overflow ko lagbhag "+pt+" m³ ke recharge pit mein bhejo.\n4) Paani bagwani, safai aur flush mein use karo.":"Pehle calculator chalao, phir main aapke numbers se plan banaunga."]
 };
}
function topic(q){q=q.toLowerCase();
 if(/purif|shudh|शुद्ध|ਸ਼ੁੱਧ|\bro\b|\buv\b/.test(q))return"purify";
 if(/plan|yojana|योजना|ਯੋਜਨਾ/.test(q))return"plan";
 if(/drink|safe|filter|pee|peene|पीने|फिल्टर|ਪੀਣ|ਫਿਲਟਰ/.test(q))return"drink";
 if(/pit|recharge|ground|रिचार्ज|ਪਿੱਟ|ਰੀਚਾਰਜ/.test(q))return"pit";
 if(/monsoon|maint|check|upkeep|barish|बारिश|मानसून|ਮੀਂਹ|ਮਾਨਸੂਨ/.test(q))return"monsoon";
 if(/tank|size|टैंक|ਟੈਂਕ/.test(q))return"tank";
 return null}
function show(text){var o=$("aiOut");o.innerHTML="";text.split("\n").forEach(function(l){var p=document.createElement("p");p.textContent=l;o.appendChild(p)});o.hidden=false}
function ask(q){
 q=(q||"").trim();if(!q)return;var lang=$("lang").value,b=$("ask"),t=topic(q);
 var local=function(){if(lang==="pa"){show(PA(last)[t||"none"]);return}if(t==="purify"){show(PUR(last)[LI[lang]]);return}var k=kb(last);show(t?k[t][LI[lang]]:["I can help with tank size, drinking safety, recharge pits, monsoon upkeep, or a full plan. Try one of the buttons above.","मैं टैंक साइज़, पीने की सुरक्षा, रिचार्ज पिट, मानसून देखभाल या पूरी योजना में मदद कर सकता हूं। ऊपर के बटन आज़माएं।","Main tank size, peene ki safety, recharge pit, monsoon dekhbhal ya poore plan mein madad kar sakta hoon. Upar ke buttons try karo."][LI[lang]])};
 if(!AI_ENDPOINT){local();$("aiOut").scrollIntoView({block:"nearest"});return}
 b.disabled=true;show("…");
 fetch(AI_ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({question:q,lang:lang,context:last})})
 .then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(j){if(!j||!j.answer)throw 0;show(String(j.answer))}).catch(local).then(function(){b.disabled=false});
}
$("ask").onclick=function(){ask($("q").value)};
$("q").addEventListener("keydown",function(e){if(e.key==="Enter")ask(this.value)});
Array.prototype.forEach.call(document.querySelectorAll(".chip[data-q]"),function(c){c.onclick=function(){$("q").value=c.dataset.q;ask(c.dataset.q)}});
function plan(){ask("plan")}
$("plan").onclick=function(){$("ai").scrollIntoView();plan()};
$("plan2").onclick=plan;
})();
</script>
